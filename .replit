modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "clinic-tests"

[[workflows.workflow]]
name = "clinic-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
CLINIC_INITIAL_ADMIN_EMAIL = "mateussmaia95@gmail.com"
WHATSMIAU_BASE_URL = "https://whatsmiau.soloventures.com.br/v1"

[userenv.production]
CLINIC_PRODUCTION_OWNER_EMAIL = "mateus@soloenergia.com.br"
CLINIC_IMPORT_ACTIVE_PATIENTS = "true"
