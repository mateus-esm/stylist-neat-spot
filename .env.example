# Local development configuration
# Copy the values from Replit's Database, Auth, and Object Storage settings into
# your local environment. Never commit a populated .env file.

# Local service routing
PORT=5173
BASE_PATH=/
VITE_API_URL=http://localhost:8080

# Replit PostgreSQL (Database tool > Settings > connection string)
DATABASE_URL=

# Clerk (Auth tool provisions these in Replit)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Leave empty during local development; production fills the proxy URL.
VITE_CLERK_PROXY_URL=

# Set this to the email of the clinic owner who should become the first admin.
CLINIC_INITIAL_ADMIN_EMAIL=

# Replit App Storage (Object Storage tool provisions these)
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Existing app session/config values
SESSION_SECRET=

# Whatsmiau Cloud API v2. The API key is only read by the server and is never
# returned to the browser or persisted in the database. The provider uses the
# `apikey` header and an instance name in the send path.
WHATSMIAU_BASE_URL=https://api.whatsmiau.dev/v2
WHATSMIAU_API_TOKEN=
WHATSMIAU_INSTANCE_NAME=
WHATSMIAU_SEND_PATH=/message/sendText/:instance
WHATSMIAU_TIMEOUT_MS=10000
# Optional shared token for POST /api/webhooks/whatsmiau. Whatsmiau's public
# contract does not document webhook signatures, so configure this token in the
# webhook URL as ?token=... when your deployment can keep it private.
WHATSMIAU_WEBHOOK_TOKEN=
# Keep asynchronous delivery disabled until the provider instance and webhook
# have been verified in production.
WHATSMIAU_ASYNC_ENABLED=false
WHATSMIAU_WORKER_INTERVAL_MS=60000